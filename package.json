{
  "name": "shortn",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "legacy",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --no-env-file scripts/dev.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky",
    "env:example": "bun run --cwd packages/env env:example",
    "db:indexes": "bun run --cwd packages/db db:indexes",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "dev:check": "bun --no-env-file scripts/dev.ts --check",
    "gen:llms": "bun apps/api/scripts/generate-docs.ts",
    "check:llms": "bun apps/api/scripts/generate-docs.ts --check"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.9.6",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "jose": "6.1.2"
  },
  "overrides": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
