# web (also uses shared variables above)
# Enable private data exports; requires object storage and export worker
EXPORTS_ENABLED=0

# Enable private CSV import dashboard flows; requires object storage and worker
IMPORTS_ENABLED=0
IMPORT_UPLOAD_PROXY_ENABLED=0

# Enable private QR export dashboard flows; requires object storage and worker
QR_EXPORTS_ENABLED=0

# Runtime environment
NODE_ENV=development

# MongoDB replica set; use TLS and per-app credentials in production
MONGODB_URL=mongodb://localhost:27017/shortn?replicaSet=rs0

# Optional audited physical collection-name overrides
MONGODB_PHYSICAL_NAMES={}

# Database name
MONGODB_DB=shortn

# Connection pool size per process
MONGODB_POOL_SIZE=20

# Evictable cache instance
REDIS_CACHE_URL=redis://localhost:6380

# No-eviction streams and queues instance
REDIS_DURABLE_URL=redis://localhost:6379

# Mount public REST API routes; default disabled
PLATFORM_API_ENABLED=0

# Percent of workspaces in the REST API cohort; explicit workspace overrides take precedence
PLATFORM_API_ROLLOUT=0

# API_KEY_PEPPER
API_KEY_PEPPER=

# Enable workspace OAuth consent for MCP; default disabled
MCP_OAUTH_ENABLED=0

# MCP_PUBLIC_ORIGIN
MCP_PUBLIC_ORIGIN=

# Percent of workspaces in the MCP cohort; explicit overrides take precedence
PLATFORM_MCP_ROLLOUT=0

# Enable outgoing webhook endpoint creation and worker delivery; default disabled
PLATFORM_WEBHOOKS_ENABLED=0

# Percent of workspaces in the outgoing webhook cohort; workspace overrides take precedence
PLATFORM_WEBHOOKS_ROLLOUT=0

# WEBHOOK_SECRET_KEY
WEBHOOK_SECRET_KEY=

# Staging only: comma-separated recipients or @domains; others are dropped
MAIL_ALLOWLIST=@denizlg24.com

# Enable production bio wildcard hosts; staging uses internal paths
BIO_SUBDOMAINS=0

# Enable /b/ 301 redirects only after slug parity acceptance
BIO_LEGACY_REDIRECTS=0

# Serve new bio renderer; /b remains legacy when disabled
BIO_DELIVERY_ENABLED=0

# Enable paid hostname provisioning after operator review
DOMAIN_WRITES=0

# Cloudflare SaaS zone ID
CLOUDFLARE_ZONE_ID=

# CLOUDFLARE_API_TOKEN
CLOUDFLARE_API_TOKEN=

# Configured Cloudflare for SaaS CNAME target
DOMAIN_CNAME_TARGET=cname.shortn.at

# Domain add-on product in the configured Polar environment; metadata shortn_addon=custom_domains
POLAR_DOMAIN_PRODUCT_ID=

# BIO_API_ORIGIN
BIO_API_ORIGIN=

# BIO_WEB_ORIGIN
BIO_WEB_ORIGIN=

# BIO_INTERNAL_SECRET
BIO_INTERNAL_SECRET=

# Self-hosted path-style S3 gateway
S3_ENDPOINT=https://api.denizlg24.com/v2

# S3 signing region
S3_REGION=eu-west-1

# S3 bucket; use shortn-v2 in production
S3_BUCKET=shortn-v2-staging

# S3 project access key
S3_ACCESS_KEY_ID=replace-me

# S3 project secret key
S3_SECRET_ACCESS_KEY=replace-me

# Authentication secret
BETTER_AUTH_SECRET=replace-with-a-distinct-secret-at-least-32-characters

# Dashboard origin (app.shortn.at); auth cookies are host-only here
BETTER_AUTH_URL=http://localhost:3000

# AUTH_GITHUB_ID
AUTH_GITHUB_ID=

# AUTH_GITHUB_SECRET
AUTH_GITHUB_SECRET=

# AUTH_GOOGLE_ID
AUTH_GOOGLE_ID=

# AUTH_GOOGLE_SECRET
AUTH_GOOGLE_SECRET=

# Polar API token
POLAR_ACCESS_TOKEN=replace-with-a-distinct-secret-at-least-32-characters

# Polar API environment
POLAR_ENVIRONMENT=sandbox

# Resend API key
RESEND_API_KEY=re_replace-me

# Sender for account and workspace email
MAIL_FROM=Shortn <no-reply@shortn.at>

# Root site origin (shortn.at) for marketing and legal links
PUBLIC_ORIGIN=http://localhost:3001

# Domain new links are created on
LINK_DOMAIN=shortn.at

# Google Web Risk key for link scans; without it scans are structural only
WEB_RISK_API_KEY=

# Link access token secret
LINK_ACCESS_SECRET=replace-with-a-distinct-secret-at-least-32-characters

# Email confirmation token secret
CONFIRMATION_TOKEN_SECRET=replace-with-a-distinct-secret-at-least-32-characters

# HMAC secret for visitor IPs (reports, rate limits)
IP_HASH_SECRET=replace-with-a-distinct-secret-at-least-32-characters

# LEGACY_ORIGIN
LEGACY_ORIGIN=

# Legacy INTERNAL_API_SECRET, sent to its revalidation hook
LEGACY_INTERNAL_SECRET=

# 1 after the billing switch: plan changes and cancellation from this app (16 D8)
BILLING_WRITES=0

# Web port
PORT=3000

# redirect (also uses shared variables above)
# Legacy JWT verification secret during M9 coexistence
AUTH_SECRET=legacy-auth-secret

# EDGE_AUTH_SECRET
EDGE_AUTH_SECRET=

# Local spool for click events while Redis is unreachable
CLICK_SPOOL_PATH=/tmp/shortn-click-spool.ndjson

# api (also uses shared variables above)
# Shared edge proof for client IP allowlists behind a reverse proxy; unset uses socket peer
API_EDGE_AUTH_SECRET=

# Shared edge proof for visitor addresses on edge-proxied public pages; unset uses CF-Connecting-IP
WEB_EDGE_AUTH_SECRET=

# Mount MCP Streamable HTTP routes; default disabled
PLATFORM_MCP_ENABLED=0

# MCP_OAUTH_ISSUER
MCP_OAUTH_ISSUER=

# Polar signature secret
POLAR_WEBHOOK_SECRET=replace-with-a-distinct-secret-at-least-32-characters

# worker (also uses shared variables above)
# Stream consumer name; defaults to the hostname
WORKER_CONSUMER=worker-1

# shadow: mirror + diff only, no emails or legacy hand-off; live after the billing switch (06)
BILLING_MODE=shadow

# APP_URL
APP_URL=

# Run continuous expand migrations every minute
RUN_CONTINUOUS_MIGRATIONS=1

# legacy infrastructure (also uses shared variables above)
# Self-hosted PiCron origin
PICRON_URL=https://picron.denizlg24.com

# PiCron username
PICRON_USERNAME=replace-me

# PiCron password
PICRON_PASSWORD=replace-me

# Legacy app origin for public asset URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator-approved exact identity provider origins; no wildcards.
SSO_TRUSTED_ORIGINS=https://login.microsoftonline.com,https://your-company.okta.com
